# Yerel Docker geliştirme varsayımları; production için güçlü parolalar kullanın.
MYSQL_ROOT_PASSWORD=change_this_local_root_password
MYSQL_DATABASE=trdizin_live
MYSQL_USER=trdizin_app
MYSQL_PASSWORD=change_this_local_app_password

TRDIZIN_BASE_URL=https://search.trdizin.gov.tr
GROBID_URL=http://grobid:8070
EXTERNAL_CONNECT_TIMEOUT=10
EXTERNAL_READ_TIMEOUT=120
MAX_PDF_BYTES=52428800
PERSISTENCE_ENABLED=true
GROBID_VERSION=0.8.0
ALGORITHM_VERSION=live-matcher-v1
