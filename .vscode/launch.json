{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "FastAPI: Docker Remote Attach",
      "type": "debugpy",
      "request": "attach",
      "connect": {
        "host": "127.0.0.1",
        "port": 5678
      },
      "pathMappings": [
        {
          "localRoot": "${workspaceFolder}/interface",
          "remoteRoot": "/app"
        }
      ],
      "justMyCode": true
    }
  ]
}
